<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- IIS error visibility (optional but useful) -->
  <system.web>
    <customErrors mode="Off" />
  </system.web>

  <system.webServer>

    <!-- iisnode handler -->
    <handlers>
      <add name="iisnode"
           path="index.js"
           verb="*"
           modules="iisnode" />
    </handlers>

    <!-- Route all requests to Node -->
    <rewrite>
      <rules>
        <rule name="NodeApp" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="index.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Disable logging to avoid permission crash -->
    <iisnode loggingEnabled="false" />

  </system.webServer>

</configuration>
